# Copy to repository root .env. Current mock mode needs no external credentials.
CODERISK_APP_NAME=CodeRisk
CODERISK_LOG_LEVEL=INFO
CODERISK_MOCK_ENABLED=true
# Trusted server allowlist for the A-01 adapter; empty means deny all.
CODERISK_GITHUB_ALLOWED_REPOSITORIES=[]
# Reserved for A / project lead; not read by the current skeleton.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
